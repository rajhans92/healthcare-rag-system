
# ======================================
# Application
# ======================================

APP_NAME=Healthcare Knowledge RAG

APP_VERSION=1.0.0

DEBUG=False

# ======================================
# Database
# ======================================

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthcare_rag

DB_ECHO=False

DB_POOL_SIZE=10

DB_MAX_OVERFLOW=20

DB_POOL_TIMEOUT=30

DB_POOL_RECYCLE=1800

AUTO_CREATE_TABLES=true
# ======================================
# JWT
# ======================================

JWT_SECRET_KEY=your-super-secret-key

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_DAYS=30

# ======================================
# AWS
# ======================================

AWS_REGION=ap-south-1

AWS_ACCESS_KEY_ID=

AWS_SECRET_ACCESS_KEY=

S3_BUCKET_NAME=

# ======================================
# Qdrant
# ======================================

QDRANT_URL=http://localhost:6333

QDRANT_API_KEY=

# ======================================
# OpenAI
# ======================================

OPENAI_API_KEY=

LLM_MODEL=gpt-5

EMBEDDING_MODEL=text-embedding-3-large

# ======================================
# Aws S3 Bucket Name
# ======================================
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=healthcare-rag-bucket
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key